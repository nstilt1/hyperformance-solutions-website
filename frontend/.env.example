# Copy to .env.local for `bun run dev`. Values are the HyperformanceSiteStack
# outputs (`aws cloudformation describe-stacks --stack-name HyperformanceSiteStack`).
# In Amplify these are set by CDK and written to .env.production by amplify.yml.
NEXT_PUBLIC_REGION=us-east-1
NEXT_PUBLIC_USER_POOL_ID=
NEXT_PUBLIC_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_UPDATE_CONTENT_URL=
NEXT_PUBLIC_PRESIGN_URL=
NEXT_PUBLIC_BUILD_STATUS_URL=
NEXT_PUBLIC_CDN_URL=
URL_PRODUCTS=
URL_PROJECTS=
URL_SERVICES=
URL_FEATURED=
# Server-only, used by /api/proxy. In Amplify they come from SSM
# (/hyperformance/build-webhooks/{site,dashboard}).
FRONTEND_BUILD_URL=
DASHBOARD_BUILD_URL=
NEXT_PUBLIC_LIST_MEDIA_URL=
